<?xml version="1.0" encoding="utf-8"?>
<!-- ODS Dataverse Audit Export - connection config.
     Copy this file to config.xml next to ods_audit_export.py and fill it in.
     KEEP config.xml PRIVATE - it contains a client secret.

     OrgUrl:       your environment URL, e.g. https://yourorg.crm.dynamics.com
     TenantId:     Microsoft Entra tenant id (Directory ID)
     ClientId:     the app registration's Application (client) ID
     ClientSecret: a client secret created on that app registration

     The app registration must be added as an Application User on the
     environment with a role that can read audit data (System Administrator
     covers it). Questions? support@orgdatasolutions.com -->
<config>
  <OrgUrl>https://yourorg.crm.dynamics.com</OrgUrl>
  <TenantId>00000000-0000-0000-0000-000000000000</TenantId>
  <ClientId>00000000-0000-0000-0000-000000000000</ClientId>
  <ClientSecret>paste-your-client-secret-here</ClientSecret>
</config>
