<?xml version="1.0" encoding="utf-8"?>
<!-- ODS Data Governance Scan - connection config.
     Copy this file to config.xml next to ods_governance_scan.py and fill it in.
     KEEP config.xml PRIVATE - it may contain a password.

     Server:       SQL Server host, e.g. sqlprod, sql\INSTANCE, or
                   yourserver.database.windows.net
     Database:     the database to scan
     Username /    a SQL login. A READ-ONLY login (db_datareader) is enough and
     Password:     is what we recommend - this tool never writes.
                   Leave both empty and set TrustedConnection to yes to use
                   your Windows account instead.
     Driver:       ODBC driver name as installed. "ODBC Driver 18 for SQL Server"
                   ships with recent SSMS; older boxes may have 17.

     Questions? support@orgdatasolutions.com -->
<config>
  <Server>your-sql-server</Server>
  <Database>YourDatabase</Database>
  <Username>readonly_user</Username>
  <Password>paste-password-here</Password>
  <TrustedConnection>no</TrustedConnection>
  <Driver>ODBC Driver 18 for SQL Server</Driver>
  <Encrypt>yes</Encrypt>
  <TrustServerCertificate>yes</TrustServerCertificate>
</config>
